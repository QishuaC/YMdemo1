.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5e6 0%, #fff 100%);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  position: relative;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 60rpx;
}

.chances-info {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}

.chances-label {
  font-size: 28rpx;
  color: #666;
}

.chances-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff9600;
  margin: 0 8rpx;
}

.chances-unit {
  font-size: 28rpx;
  color: #666;
}

.draw-section {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}

.prize-display {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.prize-wheel {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9600 0%, #ff7a00 50%, #ff9600 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 150, 0, 0.4);
  position: relative;
}

.prize-wheel.spinning {
  animation: spin 2s ease-in-out;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1080deg); }
}

.wheel-center {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-icon {
  font-size: 80rpx;
}

.draw-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff9600 0%, #ff7a00 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 150, 0, 0.4);
}

.draw-btn.disabled {
  background: #ccc;
  box-shadow: none;
  color: #999;
}

.prizes-list {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}

.prizes-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.prizes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.prize-item {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.prize-item-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.prize-item-name {
  font-size: 26rpx;
  color: #333;
}

.history-section {
  padding: 0 30rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.history-prize {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}

.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.result-prize {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff9600;
  margin-bottom: 40rpx;
}

.result-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff9600 0%, #ff7a00 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 24rpx;
  font-weight: 600;
}
