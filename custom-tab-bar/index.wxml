<view class="tabbar" wx:if="{{visible}}">
  <view class="container">
    <view wx:for="{{list}}" wx:key="index" class="item {{selected === index ? 'active' : ''}} {{clickedIndex === index ? 'clicked' : ''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
      <view class="icon-wrap">
        <image wx:if="{{item.iconPath && item.selectedIconPath}}" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" class="image-icon" mode="aspectFit"></image>
        <text wx:else class="icon">{{item.icon}}</text>
      </view>
      <text class="text">{{item.text}}</text>
    </view>
  </view>
  <view class="safe"></view>
</view>
