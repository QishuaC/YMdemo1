.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 20rpx;
}

.article-list {
  width: 100%;
}

.article-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.article-hover {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
}

.article-cover-wrapper {
  position: relative;
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.article-cover {
  width: 100%;
  height: 100%;
  transition: transform 0.5s ease;
}

.article-item:active .article-cover {
  transform: scale(1.05);
}

.vip-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: linear-gradient(45deg, #ff6b6b, #f06595, #ff6b6b);
  background-size: 200% 200%;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.4);
  animation: gradientFlow 3s ease infinite;
  z-index: 10;
}

.vip-badge text {
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.article-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  flex-wrap: wrap;
}

.article-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.article-author {
  color: #555;
  font-weight: 500;
  margin-right: 20rpx;
}

.article-time,
.article-views {
  margin-right: 20rpx;
}

/* Skeleton Styles */
.skeleton-item {
  background: #fff;
}

.skeleton-block {
  background: linear-gradient(90deg, #f1f3f5 25%, #e9ecef 37%, #f1f3f5 63%);
  background-size: 400% 100%;
  animation: skeletonShimmer 1.4s ease infinite;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
  background: linear-gradient(90deg, #f1f3f5 25%, #e9ecef 37%, #f1f3f5 63%);
  background-size: 400% 100%;
  animation: skeletonShimmer 1.4s ease infinite;
}

.skeleton-title {
  width: 90%;
  height: 32rpx;
  margin-bottom: 16rpx;
}

.skeleton-summary {
  width: 75%;
}

.skeleton-meta {
  width: 55%;
  margin-top: auto;
}

@keyframes skeletonShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
