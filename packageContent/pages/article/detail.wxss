.container {
  padding: 30rpx;
  background-color: #fff;
  min-height: 100vh;
}

.article-header {
  margin-bottom: 40rpx;
}

.article-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: block;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.author-info {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.author-name {
  color: #666;
}

.publish-time {
  margin-right: 20rpx;
}

.views-count {
  margin-left: auto;
}

.article-cover-container {
  margin: 0 -30rpx 40rpx;
}

.article-cover {
  width: 100%;
}

.article-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  padding-bottom: 100rpx;
}

.content-text {
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
}

.article-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.footer-item {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 28rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
  font-size: 28rpx;
}