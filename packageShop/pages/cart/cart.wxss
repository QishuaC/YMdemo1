.cart-list {
  padding-bottom: 140rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-checkbox {
  padding: 10rpx;
  margin-right: 10rpx;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: #07c160;
  border-color: #07c160;
}

.item-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.item-name {
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.btn-minus,
.btn-plus {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  font-size: 32rpx;
  color: #333;
}

.btn-minus {
  border-radius: 8rpx 0 0 8rpx;
}

.btn-plus {
  border-radius: 0 8rpx 8rpx 0;
}

.quantity {
  width: 70rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
  border-top: 2rpx solid #f5f5f5;
  border-bottom: 2rpx solid #f5f5f5;
  padding: 8rpx 0;
}

.item-delete {
  padding: 20rpx;
  font-size: 40rpx;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 150rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shop-btn {
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
}

.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.select-all {
  display: flex;
  align-items: center;
}

.select-text {
  font-size: 28rpx;
  margin-left: 10rpx;
}

.total-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  margin-right: 20rpx;
}

.total-label {
  font-size: 28rpx;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.total-origin {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.total-discount {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #ff7a00;
}

.checkout-btn {
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}
