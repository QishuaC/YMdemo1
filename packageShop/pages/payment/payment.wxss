.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.address-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.address-header {
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.change-btn {
  font-size: 26rpx;
  color: #07c160;
}

.address-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.address-info {
  line-height: 1.6;
}

.address-contact {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.contact-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-right: 20rpx;
}

.contact-phone {
  font-size: 28rpx;
  color: #666;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
}

.no-address .address-header {
  margin-bottom: 20rpx;
}

.no-address-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.no-address-text {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.add-address-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border: none;
  line-height: 1;
}

.payment-header {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  padding: 80rpx 30rpx 60rpx;
}

.amount-section {
  text-align: center;
}

.amount-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.amount-value {
  display: block;
  font-size: 72rpx;
  color: #fff;
  font-weight: 600;
}

.member-discount-highlight {
  margin-top: 20rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.discount-main {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.discount-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  text-decoration: line-through;
}

.order-info {
  background: #fff;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row:first-child {
  padding-top: 0;
}

.info-row:last-child {
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.product-title .info-value {
  flex: 1;
  text-align: right;
  color: #07c160;
  font-weight: 600;
  font-size: 30rpx;
}

.payment-methods {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.method-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.method-item:last-child {
  border-bottom: none;
}

.method-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.method-item.selected .method-check {
  border-color: #07c160;
  background: #07c160;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.payment-tips {
  margin: 0 20rpx;
  padding: 20rpx;
  background: rgba(255, 193, 7, 0.1);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.tips-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: #faad14;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.pay-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 26rpx;
  font-weight: 600;
  border: none;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 560rpx;
  text-align: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: #07c160;
  border-radius: 50%;
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}

.success-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.success-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.points-reward {
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  margin-bottom: 40rpx;
}

.points-label {
  font-size: 26rpx;
  color: #8b4513;
  margin-right: 10rpx;
}

.points-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #8b4513;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 24rpx;
  border: none;
}

.modal-btn.secondary {
  background: #f5f5f5;
  color: #333;
}

.address-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.address-selector-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.address-selector-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.selector-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.close-selector {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.address-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}

.address-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.address-item-info {
  flex: 1;
}

.address-item-contact {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
}

.address-item-phone {
  font-size: 26rpx;
  color: #666;
  margin-right: 16rpx;
}

.address-item-detail {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.address-item .check-icon {
  width: 40rpx;
  height: 40rpx;
  background: #07c160;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-new-address {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.add-icon {
  font-size: 40rpx;
  color: #07c160;
  margin-right: 12rpx;
}

.add-text {
  font-size: 28rpx;
  color: #07c160;
}
