page {
  height: 100%;
}

.video-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.top-tabs {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 999999 !important;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 20rpx;
  background: linear-gradient(rgba(0,0,0,0.9), transparent);
  touch-action: none;
}

.tab-btn {
  margin: 0 25rpx;
  font-size: 30rpx;
  color: rgba(255,255,255,0.6);
  padding: 10rpx 0;
  position: relative;
}

.tab-btn.active {
  color: #fff;
  font-weight: bold;
  font-size: 36rpx;
}

.tab-btn.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 4rpx;
}

.video-swiper {
  width: 100%;
  height: 100%;
}

.single-video {
  width: 100%;
  height: 100%;
  position: relative;
}

.video-player {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.video-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  background: linear-gradient(transparent 50%, rgba(0,0,0,0.8));
  z-index: 1;
}

.video-info {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 160rpx;
  display: flex;
  justify-content: flex-start;
  align-items: flex-end;
  padding: 0 20rpx;
  z-index: 998;
}

.left-part {
  flex: 1;
  margin-right: 20rpx;
  color: #fff;
}

.author-line {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  width: 100%;
}

.author-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  margin-right: 20rpx;
}

.author-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-right: 25rpx;
}

.follow-btn {
  background: #ff2442;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 15rpx 80rpx;
  border-radius: 50rpx;
  line-height: 1;
  flex: 1;
  margin-right: 20rpx;
  border: none;
}

.video-text {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 500;
}

.right-part {
  position: absolute;
  right: 20rpx;
  bottom: 150rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
  min-width: 100rpx;
  min-height: 100rpx;
}

.share-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  border: 3rpx solid #fff;
  border-radius: 50%;
  padding: 15rpx;
  margin: 0 0 40rpx 0;
  min-width: 110rpx;
  min-height: 110rpx;
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.5);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 4rpx 20rpx rgba(255, 107, 107, 0.5);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 4rpx 30rpx rgba(255, 107, 107, 0.8);
  }
}

.share-btn-container {
  position: absolute;
  right: 15rpx;
  bottom: 360rpx;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-btn-top {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  border: 4rpx solid #fff;
  border-radius: 50%;
  padding: 20rpx;
  min-width: 120rpx;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 30rpx rgba(255, 107, 107, 0.7);
  animation: pulse 2s infinite;
}

.share-icon {
  font-size: 60rpx;
  margin-bottom: 5rpx;
}

.share-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.share-btn .icon {
  font-size: 55rpx;
}

.count {
  color: #fff;
  font-size: 24rpx;
}

.share-btn .count {
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

.music-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  animation: rotate 4s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.play-center {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  pointer-events: auto;
}

.play-icon {
  width: 150rpx;
  height: 150rpx;
  background: rgba(0,0,0,0.4);
  border-radius: 50%;
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 10rpx;
}
