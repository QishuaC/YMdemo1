.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fef7f7 0%, #f5f5f5 100%);
  padding-bottom: 40rpx;
}

.points-header {
  padding: 30rpx;
  position: relative;
  overflow: hidden;
}

.points-header::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 107, 107, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.points-card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 50%, #ffd93d 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 107, 0.35);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.points-card::after {
  content: '';
  position: absolute;
  top: -50rpx;
  left: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.points-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  flex-shrink: 0;
}

.points-main-icon {
  font-size: 64rpx;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.points-content {
  flex: 1;
  z-index: 1;
}

.points-label {
  display: block;
  color: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.points-value-wrapper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.points-value {
  display: block;
  color: #fff;
  font-size: 72rpx;
  font-weight: 800;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 2rpx;
}

.points-history-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  backdrop-filter: blur(10rpx);
  flex-shrink: 0;
  margin-top: 4rpx;
}

.history-btn-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.points-tip {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.4;
}

.points-decoration {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  gap: 8rpx;
}

.decoration-dot {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

.exchange-section {
  padding: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 8rpx;
}

.section-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.product-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.product-cover-wrapper {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
}

.product-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.tag-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.points-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.points-icon {
  font-size: 24rpx;
}

.points-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #ff6b6b;
}

.points-unit {
  font-size: 22rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.exchange-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s ease;
}

.exchange-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.4);
}

.exchange-btn.disabled {
  background: linear-gradient(135deg, #e0e0e0 0%, #d0d0d0 100%);
  box-shadow: none;
}

.btn-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.exchange-btn.disabled .btn-text {
  color: #999;
}

.tips-section {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.tips-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tips-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
