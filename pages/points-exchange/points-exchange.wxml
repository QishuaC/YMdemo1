<view class="container">
  <view class="points-header">
    <view class="points-card">
      <view class="points-icon-wrapper">
        <text class="points-main-icon">🎯</text>
      </view>
      <view class="points-content">
        <text class="points-label">我的积分</text>
        <view class="points-value-wrapper">
          <text class="points-value">{{points}}</text>
          <view class="points-history-btn" bindtap="goToPointsHistory">
            <text class="history-btn-text">积分记录</text>
          </view>
        </view>
        <text class="points-tip">积分可用于兑换优惠券和精美礼品</text>
      </view>
      <view class="points-decoration">
        <text class="decoration-dot"></text>
        <text class="decoration-dot"></text>
        <text class="decoration-dot"></text>
      </view>
    </view>
  </view>

  <view class="exchange-section">
    <view class="section-header">
      <text class="section-title">热门兑换</text>
      <text class="section-subtitle">精选好物，限时兑换</text>
    </view>
    
    <view class="product-grid">
      <view class="product-card" wx:for="{{exchangeProducts}}" wx:key="id">
        <view class="product-cover-wrapper">
          <image class="product-cover" src="{{item.cover}}" mode="aspectFill" binderror="handleImageError" data-id="{{item.id}}"></image>
          <view class="product-tag" wx:if="{{item.originalPrice}}">
            <text class="tag-text">价值¥{{item.originalPrice}}</text>
          </view>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.description}}</text>
          <view class="product-bottom">
            <view class="points-price">
              <text class="points-icon">✨</text>
              <text class="points-num">{{item.pointsRequired}}</text>
              <text class="points-unit">积分</text>
            </view>
            <view 
              class="exchange-btn {{points >= item.pointsRequired ? '' : 'disabled'}}" 
              bindtap="handleExchange" 
              data-product="{{item}}"
            >
              <text class="btn-text">{{points >= item.pointsRequired ? '立即兑换' : '积分不足'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tips-section">
    <view class="tips-card">
      <text class="tips-icon">💡</text>
      <view class="tips-content">
        <text class="tips-title">获取积分方式</text>
        <text class="tips-text">1. 购物消费每1元获得1积分</text>
        <text class="tips-text">2. 每日签到可获得额外积分</text>
        <text class="tips-text">3. 参与活动赢取更多积分</text>
      </view>
    </view>
  </view>
</view>
