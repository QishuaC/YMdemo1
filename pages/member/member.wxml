<view class="container">
  <view class="member-header card">
    <view class="user-info" bindtap="handleLogin">
      <image class="user-avatar" src="{{userInfo.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}"></image>
      <view class="user-detail">
        <view class="user-name-row">
          <view class="user-name-wrap">
            <yimen-badge wx:if="{{isLoggedIn && userInfo.nickName}}" />
            <text class="user-name {{isMember && isLoggedIn ? 'colorful' : ''}}">{{userInfo.nickName || '点击登录'}}</text>
          </view>
          <view class="gender-badge" wx:if="{{userInfo && userInfo.gender && userInfo.gender !== ''}}" data-gender="{{userInfo.gender}}">
            <text class="gender-icon">{{(userInfo.gender === 1 || userInfo.gender === 'male') ? '♂' : '♀'}}</text>
          </view>
        </view>
        <view class="member-level" wx:if="{{isMember && isLoggedIn}}">
          <text class="level-icon">👑</text>
          <text class="level-name">{{memberPlan === 'yearly' ? '义门年卡会员' : '义门月卡会员'}}</text>
        </view>
        <text class="login-tip" wx:if="{{!isLoggedIn}}">登录后享受更多权益</text>
      </view>
    </view>
    <view class="member-stats">
      <view class="stat-item checkin-item {{hasCheckedIn ? 'checked' : ''}}" bindtap="handleCheckIn">
        <view class="checkin-value-container">
          <text class="stat-value">{{monthlyCheckInCount}}</text>
          <text class="checkin-unit">天</text>
        </view>
        <text class="stat-label">{{hasCheckedIn ? '已签到' : '签到'}}</text>
        <text class="checkin-status" wx:if="{{hasCheckedIn}}">✓</text>
        <text class="checkin-month">本月</text>
      </view>
      <view class="stat-item" bindtap="goToPointsExchange">
        <text class="stat-value">{{points}}</text>
        <text class="stat-label">积分</text>
        <text class="stat-arrow">></text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{coupons}}</text>
        <text class="stat-label">优惠券</text>
      </view>
    </view>
  </view>

  <view class="member-benefits card" wx:if="{{isMember && isLoggedIn}}">
    <view class="benefits-title">会员权益</view>
    <view class="benefits-list">
      <view class="benefit-item">
        <text class="benefit-icon">🌈</text>
        <text class="benefit-text">专属炫彩昵称</text>
      </view>
      <view class="benefit-item" bindtap="claimBenefit" data-type="badge">
        <text class="benefit-icon">🏅</text>
        <view class="benefit-text-wrap">
          <text class="benefit-text">领取专属义门编号徽章</text>
          <text class="benefit-sub">年卡额外赠送实体编号徽章</text>
        </view>
        <text class="benefit-status {{memberBenefits.badgeDigitalClaimed ? 'claimed' : 'claimable'}}">
          {{memberBenefits.badgeDigitalClaimed ? '已领取' : '立即领取'}}
        </text>
      </view>
      <view class="benefit-item" bindtap="claimBenefit" data-type="genealogy">
        <text class="benefit-icon">📘</text>
        <view class="benefit-text-wrap">
          <text class="benefit-text">领取陈氏通谱电子版</text>
          <text class="benefit-sub">年卡额外获赠实体版通谱</text>
        </view>
        <text class="benefit-status {{memberBenefits.genealogyDigitalClaimed ? 'claimed' : 'claimable'}}">
          {{memberBenefits.genealogyDigitalClaimed ? '已领取' : '立即领取'}}
        </text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">✅</text>
        <text class="benefit-text">每日签到双倍积分</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">💎</text>
        <text class="benefit-text">所有商品95折</text>
      </view>
    </view>
    <view class="expiry-info">
      <text class="expiry-label">会员有效期至：</text>
      <text class="expiry-date">{{memberExpiry}}</text>
    </view>
  </view>

  <view class="menu-list card">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="handleMenu" data-index="{{index}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="level-section card" wx:if="{{!isMember && isLoggedIn}}">
    <view class="level-title">开通义门会员</view>
    <view class="plan-grid">
      <view class="vip-card {{selectedPlan === 'monthly' ? 'selected' : ''}}" data-plan="monthly" bindtap="handlePlanSelect">
        <text class="vip-icon">👑</text>
        <text class="vip-name">义门月卡</text>
        <view class="vip-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{memberPricing.monthly}}</text>
          <text class="price-unit">/月</text>
        </view>
      </view>
      <view class="vip-card {{selectedPlan === 'yearly' ? 'selected' : ''}}" data-plan="yearly" bindtap="handlePlanSelect">
        <text class="vip-icon">🏆</text>
        <text class="vip-name">义门年卡</text>
        <view class="vip-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{memberPricing.yearly}}</text>
          <text class="price-unit">/年</text>
        </view>
      </view>
    </view>
    <view class="vip-benefits-mini">
      <text>炫彩昵称 · 编号徽章 · 陈氏通谱 · 双倍签到 · 全场95折</text>
    </view>
    <button class="join-btn" bindtap="joinMember">立即开通</button>
  </view>

  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
