<view class="container">
  <view class="payment-header">
    <view class="amount-section">
      <text class="amount-label">支付金额</text>
      <text class="amount-value">¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="order-info">
    <view class="info-row product-title" wx:if="{{productTitle}}">
      <text class="info-label">商品</text>
      <text class="info-value product-name">{{productTitle}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{orderNumber}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单时间</text>
      <text class="info-value">{{createTime}}</text>
    </view>
  </view>

  <view class="payment-methods">
    <view class="method-title">选择支付方式</view>
    <view class="method-item selected">
      <text class="method-icon">💬</text>
      <text class="method-name">微信支付</text>
      <view class="method-check">
        <text class="check-icon">✓</text>
      </view>
    </view>
  </view>

  <view class="address-section" wx:if="{{address}}">
    <view class="address-header">
      <text class="address-label">收货地址</text>
      <text class="change-btn" bindtap="showAddressSelector">修改</text>
    </view>
    <view class="address-info">
      <view class="address-contact">
        <text class="contact-name">{{address.name}}</text>
        <text class="contact-phone">{{address.phone}}</text>
      </view>
      <text class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
    </view>
  </view>

  <view class="address-section no-address" wx:else>
    <view class="address-header">
      <text class="address-label">收货地址</text>
    </view>
    <view class="no-address-info">
      <text class="no-address-text">请先添加收货地址</text>
      <button class="add-address-btn" bindtap="goToAddAddress">添加地址</button>
    </view>
  </view>

  <view class="payment-tips">
    <text class="tips-icon">⚠️</text>
    <text class="tips-text">请在15分钟内完成支付，超时订单将自动取消</text>
  </view>

  <view class="bottom-bar">
    <button class="pay-btn" bindtap="doPay">立即支付</button>
  </view>

  <view class="success-modal" wx:if="{{showSuccess}}">
    <view class="modal-content">
      <view class="success-icon">✓</view>
      <text class="success-title">支付成功</text>
      <text class="success-text">订单支付已完成</text>
      <view class="points-reward" wx:if="{{earnedPoints > 0}}">
        <text class="points-label">获得积分</text>
        <text class="points-value">+{{earnedPoints}}</text>
      </view>
      <view class="modal-buttons">
        <button class="modal-btn secondary" bindtap="goBack">返回义闻</button>
        <button class="modal-btn primary" bindtap="goToOrder">查看订单</button>
      </view>
    </view>
  </view>

  <view class="address-selector-modal" wx:if="{{showAddressSelector}}">
    <view class="address-selector-mask" bindtap="closeAddressSelector"></view>
    <view class="address-selector-content">
      <view class="selector-header">
        <text class="selector-title">选择收货地址</text>
        <text class="close-selector" bindtap="closeAddressSelector">✕</text>
      </view>
      <view class="address-list">
        <view class="address-item" wx:for="{{addressList}}" wx:key="id" bindtap="selectAddress" data-id="{{item.id}}">
          <view class="address-item-info">
            <view class="address-item-contact">
              <text class="address-item-name">{{item.name}}</text>
              <text class="address-item-phone">{{item.phone}}</text>
              <view class="default-tag" wx:if="{{item.isDefault}}">默认</view>
            </view>
            <text class="address-item-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
          </view>
          <view class="check-icon" wx:if="{{address && address.id == item.id}}">✓</view>
        </view>
        <view class="add-new-address" bindtap="goToAddAddress">
          <text class="add-icon">+</text>
          <text class="add-text">添加新地址</text>
        </view>
      </view>
    </view>
  </view>
</view>