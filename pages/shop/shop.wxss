page {
  background: #f5f5f5;
}

.container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 0 20rpx 0;
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 18rpx 30rpx;
  margin-right: 20rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.search-icon {
  margin-right: 15rpx;
  font-size: 28rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.cart-icon {
  position: relative;
  font-size: 48rpx;
  padding: 10rpx;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.category-tabs {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
}

.tab-item {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 50rpx;
  margin-right: 15rpx;
  background: #f5f7fa;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.35);
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

.banner-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 20rpx;
}

.banner-btn {
  display: inline-block;
  background: #ffc107;
  color: #333;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  width: fit-content;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 380rpx;
}

.product-cover {
  width: 100%;
  height: 100%;
}

.product-tags {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.promo-tag {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.product-meta {
  margin-bottom: 10rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  gap: 8rpx;
}

.service-tag {
  background: rgba(76, 175, 80, 0.1);
  color: #4caf50;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  border: 1px solid rgba(76, 175, 80, 0.3);
}

.product-category {
  font-size: 22rpx;
  color: #8b0000;
  background: rgba(139,0,0,0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
  line-height: 1;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
  line-height: 1;
}

.original-price {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 4rpx;
}

.product-right {
  display: flex;
  align-items: flex-end;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
  margin: 0;
}
