.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #07c160;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.order-number {
  font-size: 26rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
}

.order-status.pending {
  color: #ff4d4f;
}

.order-status.paid {
  color: #1890ff;
}

.order-status.shipping {
  color: #faad14;
}

.order-status.delivered {
  color: #07c160;
}

.order-status.cancelled {
  color: #999;
}

.shipping-info {
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #ffd591;
}

.shipping-status {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.shipping-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.shipping-status-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
}

.shipping-status-text.shipped {
  color: #07c160;
}

.tracking-number {
  display: flex;
  align-items: center;
}

.tracking-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.tracking-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  font-family: monospace;
}

.shipped-time {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.shipped-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.shipped-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.order-address {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.order-address .address-info {
  line-height: 1.6;
  flex: 1;
  margin-right: 20rpx;
}

.edit-address-btn {
  padding: 12rpx 24rpx;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 50rpx;
  color: #07c160;
  font-size: 24rpx;
  flex-shrink: 0;
  line-height: 1;
}

.order-address .address-contact {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-address .contact-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-right: 20rpx;
}

.order-address .contact-phone {
  font-size: 26rpx;
  color: #666;
}

.order-address .address-detail {
  font-size: 24rpx;
  color: #666;
}

.order-items {
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  margin-bottom: 16rpx;
}

.item:last-child {
  margin-bottom: 0;
}

.item-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.item-quantity {
  font-size: 26rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 600;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border-radius: 50rpx;
  border: 1rpx solid #ddd;
  background: #fff;
  color: #666;
  line-height: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background: #07c160;
  color: #fff;
  border-color: #07c160;
}

.action-btn.cancel {
  background: #fff;
  color: #999;
  border-color: #ddd;
}

.countdown-wrapper {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background: #fff7e6;
  border-radius: 50rpx;
  border: 1rpx solid #ffd591;
}

.countdown-text {
  font-size: 24rpx;
  color: #fa8c16;
  white-space: nowrap;
}

.countdown-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin: 0 8rpx;
  font-family: monospace;
  white-space: nowrap;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  z-index: 1000;
  overflow: hidden;
}

.dialog-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
}

.dialog-body {
  padding: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.input {
  flex: 1;
  height: 70rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.dialog-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border: none;
  background: none;
}

.btn-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn-confirm {
  color: #07c160;
}
