<view class="container">
  <view class="tabs">
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab-item {{activeTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">待付款</view>
    <view class="tab-item {{activeTab === 'paid' ? 'active' : ''}}" bindtap="switchTab" data-tab="paid">待发货</view>
    <view class="tab-item {{activeTab === 'shipping' ? 'active' : ''}}" bindtap="switchTab" data-tab="shipping">待收货</view>
    <view class="tab-item {{activeTab === 'delivered' ? 'active' : ''}}" bindtap="switchTab" data-tab="delivered">已完成</view>
  </view>

  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="viewOrderDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-number">订单号：{{item.orderNumber}}</text>
        <text class="order-status {{item.status === 'paid' && item.shippingStatus === 'shipped' ? 'shipping' : item.status}}">{{item.statusText}}</text>
      </view>
      
      <view class="shipping-info" wx:if="{{item.shippingStatus === 'shipped'}}">
        <view class="shipping-status">
          <text class="shipping-label">发货状态：</text>
          <text class="shipping-status-text shipped">{{item.shippingStatusText}}</text>
        </view>
        <view class="shipped-time" wx:if="{{item.shippedAt}}">
          <text class="shipped-label">发货时间：</text>
          <text class="shipped-value">{{item.shippedAt}}</text>
        </view>
        <view class="tracking-number" wx:if="{{item.trackingNumber}}">
          <text class="tracking-label">快递单号：</text>
          <text class="tracking-value">{{item.trackingNumber}}</text>
        </view>
      </view>
      
      <view class="shipping-info" wx:if="{{item.shippingStatus !== 'shipped' && item.shippingStatus}}">
        <view class="shipping-status">
          <text class="shipping-label">发货状态：</text>
          <text class="shipping-status-text">{{item.shippingStatusText}}</text>
        </view>
      </view>
      
      <view class="order-address" wx:if="{{item.address}}">
        <view class="address-info">
          <view class="address-contact">
            <text class="contact-name">{{item.address.name}}</text>
            <text class="contact-phone">{{item.address.phone}}</text>
          </view>
          <text class="address-detail">{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail}}</text>
        </view>
        <view class="edit-address-btn" wx:if="{{item.status === 'paid'}}" catchtap="editOrderAddress" data-id="{{item.id}}">
          <text>修改</text>
        </view>
      </view>
      
      <view class="order-items">
        <view class="item" wx:for="{{item.items}}" wx:key="id" wx:for-item="product">
          <image class="item-cover" src="{{product.cover}}" mode="aspectFill"></image>
          <view class="item-info">
            <text class="item-name">{{product.name}}</text>
            <view class="item-bottom">
              <text class="item-price">¥{{product.price}}</text>
              <text class="item-quantity">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="order-footer">
        <text class="order-time">{{item.createTime}}</text>
        <view class="order-total">
          <text class="total-label">实付：</text>
          <text class="total-price">¥{{item.totalPrice}}</text>
        </view>
      </view>
      
      <view class="order-actions" wx:if="{{item.status === 'pending'}}">
        <view class="countdown-wrapper">
          <text class="countdown-text">订单将在</text>
          <text class="countdown-time">{{item.countdownText}}</text>
          <text class="countdown-text">后自动取消</text>
        </view>
        <button class="action-btn primary" catchtap="payOrder" data-id="{{item.id}}">立即支付</button>
      </view>
      
      <view class="order-actions" wx:if="{{item.status === 'shipping' || (item.status === 'paid' && item.shippingStatus === 'shipped')}}">
        <button class="action-btn primary" catchtap="confirmReceive" data-id="{{item.id}}">确认收货</button>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{orders.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单</text>
    </view>
  </view>
</view>

<view class="dialog-mask" wx:if="{{showEditAddressDialog}}" bindtap="closeEditAddressDialog"></view>
<view class="dialog" wx:if="{{showEditAddressDialog}}">
  <view class="dialog-header">
    <text>修改收货地址</text>
    <text class="close-btn" bindtap="closeEditAddressDialog">✕</text>
  </view>
  <view class="dialog-body">
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="input" placeholder="请输入收货人姓名" value="{{editAddress.name}}" data-field="name" bindinput="onAddressInputChange" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{editAddress.phone}}" data-field="phone" bindinput="onAddressInputChange" />
    </view>
    <view class="form-item">
      <text class="label">省/市/区</text>
      <input class="input" placeholder="请输入省市区" value="{{editAddress.province}}" data-field="province" bindinput="onAddressInputChange" />
    </view>
    <view class="form-item">
      <text class="label">详细地址</text>
      <input class="input" placeholder="请输入详细地址" value="{{editAddress.detail}}" data-field="detail" bindinput="onAddressInputChange" />
    </view>
  </view>
  <view class="dialog-footer">
    <button class="btn-cancel" bindtap="closeEditAddressDialog">取消</button>
    <button class="btn-confirm" bindtap="saveOrderAddress">保存</button>
  </view>
</view>
