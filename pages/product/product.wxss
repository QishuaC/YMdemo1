.container {
  padding-bottom: 120rpx;
}

.product-gallery {
  margin-bottom: 20rpx;
}

.gallery-swiper {
  width: 100%;
  height: 750rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 15rpx;
}

.original-price {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 15rpx;
}

.sales {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.product-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: block;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.product-detail {
  padding: 30rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.detail-content {
  line-height: 1.8;
}

.detail-image {
  width: 100%;
  margin-bottom: 20rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  width: 100%;
}

.bar-left {
  display: flex;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  position: relative;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 5rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #666;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 15rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.bar-right {
  display: flex;
  flex: 1;
  justify-content: flex-end;
  gap: 15rpx;
}

.btn-cart,
.btn-buy {
  border-radius: 50rpx;
  padding: 20rpx 20rpx;
  font-size: 28rpx;
  flex: 1;
  min-width: 0;
  max-width: 200rpx;
  white-space: nowrap;
  border: none;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-cart {
  background: #ff976a;
  color: #fff;
}

.btn-buy {
  background: #07c160;
  color: #fff;
}
