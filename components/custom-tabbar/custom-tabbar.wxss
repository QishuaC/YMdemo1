.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tabbar-container {
  display: flex;
  height: 100rpx;
  padding-bottom: 0;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}

.tabbar-icon {
  margin-bottom: 6rpx;
  position: relative;
}

.icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.tabbar-item.active .icon-wrapper {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.35);
}

.icon-text {
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.tabbar-item .icon-text {
  color: #8a8a8a;
}

.tabbar-item.active .icon-text {
  color: #ffffff;
}

.tabbar-text {
  font-size: 22rpx;
  transition: all 0.3s ease;
}

.tabbar-item .tabbar-text {
  color: #8a8a8a;
}

.tabbar-item.active .tabbar-text {
  color: #07c160;
  font-weight: 600;
}

.safe-area {
  height: env(safe-area-inset-bottom);
  background: #ffffff;
}
