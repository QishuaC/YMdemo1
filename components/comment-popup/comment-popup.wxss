.comment-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 70vh;
  max-height: 70vh;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  z-index: 10000;
}

.popup-content.with-tabbar {
  bottom: calc(100rpx + env(safe-area-inset-bottom));
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-count {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.comment-list {
  flex: 1;
  flex-grow: 1;
  flex-shrink: 1;
  height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 30rpx;
  width: 100%;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
  min-height: 0;
}

.comment-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  width: 100%;
  box-sizing: border-box;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-user {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-user-name {
  font-size: 28rpx;
  color: #666;
}

.comment-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 15rpx;
  word-break: break-all;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 32rpx;
}

.action-icon.liked {
  color: #ff4757;
}

.action-count {
  font-size: 24rpx;
  color: #999;
}

.action-text {
  font-size: 28rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 20rpx;
  font-weight: 500;
}

.replies {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.reply-item {
  display: flex;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.reply-main {
  flex: 1;
  min-width: 0;
}

.reply-user {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-user-name {
  font-size: 26rpx;
  color: #666;
}

.reply-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.reply-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reply-time {
  font-size: 22rpx;
  color: #999;
}

.reply-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.load-more-replies {
  padding: 15rpx 0;
  text-align: center;
}

.load-more-replies text {
  font-size: 26rpx;
  color: #1890ff;
}

.loading-more,
.no-more,
.empty-comments {
  padding: 40rpx 0;
  text-align: center;
}

.loading-more text,
.no-more text,
.empty-comments text {
  font-size: 28rpx;
  color: #999;
}

.comment-input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
  flex-grow: 0;
  z-index: 10;
  min-height: 120rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
}

.comment-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
  color: #333;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  position: relative;
  z-index: 20;
  cursor: pointer;
}

.send-btn.disabled {
  background: #ccc;
  opacity: 0.6;
  pointer-events: none;
  box-shadow: none;
}
